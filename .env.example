# Copy to .env for LOCAL use only. Never commit .env.
APP_NAME=ProductAPI
APP_ENV=development
APP_KEY=

# Aiven MySQL (Console > your service > Overview > Connection information)
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=defaultdb
# Path to Aiven CA certificate (download ca.pem from the Aiven console)
DB_SSL_CA=certs/ca.pem
# Set to false only if you get a certificate-verification error (still encrypted)
DB_SSL_VERIFY=true

# JWT secrets: generate each with  php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Frontend URL allowed by CORS (use * only while testing)
ALLOWED_ORIGIN=http://localhost:5173

# Only set true when you intentionally run migrations; keep false on Render
MIGRATION_ENABLED=true
